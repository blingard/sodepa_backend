# ── Redis ──
# ATTENTION: la valeur par défaut d'origine pour REDIS_PORT était "redispassword" (probable erreur dans le YAML source)
REDIS_PORT=6379
REDIS_IP=localhost
REDIS_PASSWORD=redispassword

# ── Base de données (PostgreSQL) ──
DB_URL=jdbc:postgresql://localhost:5433/sodepa
DB_USERNAME=toto
DB_PASSWORD=12345
DB_DDL=validate
DB_SHOW_SQL=false
DB_SHOW_SQL_FORMAT=false

# ── RabbitMQ ──
RABBITMQ_IP=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ── Sécurité / OAuth2 / Keycloak ──
JWT_URI=http://localhost:8070/realms/sodepa
JWK_URI=http://localhost:8070/realms/sodepa/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=sodepa
KEYCLOAK_CLIENT_SECRET=YrLn2AuVUNAtafaOtj8DDs4CFJrv4eMp
KEYCLOAK_DEFAULT_PASSWORD=DefaultPassword123!
KEYCLOAK_SERVER_URL=http://localhost:8070
KEYCLOAK_REALM=sodepa

# ── Serveur ──
SERVER_PORT=8087

# ── Minio ──
MINIO_ENDPOINT=http://localhost:7004
MINIO_FILEURL=http://localhost:7004
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# ── Collabora ──
COLLABORA_URL=http://localhost:9980

# ── App ──
BACK_END_BASE_URL=http://172.24.208.1:8087

# ── ClickHouse ──
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
