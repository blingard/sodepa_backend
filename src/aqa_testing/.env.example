# ---- Cibles ----
# API : backend Spring Boot (server.port du sodepa_backend)
API_BASE_URL=http://localhost:8082
# UI : front de l'ERP (adapter au port réel une fois le front disponible)
UI_BASE_URL=http://localhost:4200

# ---- Comptes de test (Keycloak realm "sodepa") ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=DefaultPassword123!
COMPTABLE_USERNAME=comptable
COMPTABLE_PASSWORD=DefaultPassword123!

# ---- Exécution ----
# true pour désactiver la réutilisation du storageState UI
HEADLESS=true
API_TIMEOUT_MS=30000
# true pour autoriser les tests destructifs (clôture d'exercice, suppressions,
# changement de mot de passe). À n'activer que sur un environnement jetable.
RUN_DESTRUCTIVE=false
