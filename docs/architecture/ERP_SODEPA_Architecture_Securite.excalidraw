   "updated": 1793000000000,
   "link": null,
   "locked": false,
   "text": "POLITIQUE CSP NGINX\n• Content-Security-Policy stricte injectée par Nginx\n• default-src 'self' ; object-src 'none'\n• connect-src restreint aux origines API_URL\n• X-Frame-Options DENY, X-Content-Type-Options nosniff",
   "originalText": "POLITIQUE CSP NGINX\n• Content-Security-Policy stricte injectée par Nginx\n• default-src 'self' ; object-src 'none'\n• connect-src restreint aux origines API_URL\n• X-Frame-Options DENY, X-Content-Type-Options nosniff",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "sf_sec_headers",
   "autoResize": true,
   "lineHeight": 1.25
