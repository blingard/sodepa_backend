   "seed": 437221894,
   "version": 1,
   "versionNonce": 1476388842,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1793000000000,
   "link": null,
   "locked": false,
   "text": "CONTRÔLE DE NAVIGATION CLIENT\n• authGuard : Vérifie la validité du token local\n• hasAnyRole / hasAnyPermission : Filtrage des routes\n• Redirection vers /login?retour=<url> si non connecté\n• Redirection vers /erreur/403 en cas de rôle\ninsuffisant",
   "originalText": "CONTRÔLE DE NAVIGATION CLIENT\n• authGuard : Vérifie la validité du token local\n• hasAnyRole / hasAnyPermission : Filtrage des routes\n• Redirection vers /login?retour=<url> si non connecté\n• Redirection vers /erreur/403 en cas de rôle\ninsuffisant",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "sf_guards",
   "autoResize": true,
   "lineHeight": 1.25
  },
