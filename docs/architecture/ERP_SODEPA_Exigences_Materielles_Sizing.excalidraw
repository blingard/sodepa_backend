    {
      "id": "87Dvu3EExHtihRkHRNLU3",
      "type": "text",
      "x": 52,
      "y": 415,
      "width": 242.3597,
      "height": 78.75,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
