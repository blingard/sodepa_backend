    {
      "id": "s41s0fglCFq02qPiwHkxH",
      "type": "text",
      "x": 875,
      "y": 153,
      "width": 593.2255999999993,
      "height": 90,
      "angle": 0,
      "strokeColor": "#166534",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a9",
      "roundness": null,
      "seed": 366294,
      "version": 3,
      "versionNonce": 1277838562,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793033126256,
      "created": 1793033126255,
      "link": null,
      "locked": false,
      "text": "• Processeur (CPU) : 8 à 16 vCPU (ou 2 nœuds de 8 vCPU) — Architecture x86_64 3.0 GHz+\n• Mémoire Vive (RAM) : 32 à 64 Go RAM ECC (minimisation des I/O disque via caches)\n• Stockage Système & Données : 1 To SSD NVMe en RAID 10 (IOPS > 10 000, latence < 1ms)\n• Bande Passante Réseau : 1 Gbps redondé (connexion Fibre Siège + liaisons sécurisées Ranches)\n• Type d'Infrastructure : Serveur Bare-Metal dédié ou Cluster de Virtualisation durci avec PRA\n• Objectif : Disponibilité 99.9%, clôtures comptables SYSCOHADA, piste d'audit temps réel infalsifiable",
      "fontSize": 12,
      "baseFontSize": null,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Processeur (CPU) : 8 à 16 vCPU (ou 2 nœuds de 8 vCPU) — Architecture x86_64 3.0 GHz+\n• Mémoire Vive (RAM) : 32 à 64 Go RAM ECC (minimisation des I/O disque via caches)\n• Stockage Système & Données : 1 To SSD NVMe en RAID 10 (IOPS > 10 000, latence < 1ms)\n• Bande Passante Réseau : 1 Gbps redondé (connexion Fibre Siège + liaisons sécurisées Ranches)\n• Type d'Infrastructure : Serveur Bare-Metal dédié ou Cluster de Virtualisation durci avec PRA\n• Objectif : Disponibilité 99.9%, clôtures comptables SYSCOHADA, piste d'audit temps réel infalsifiable",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
