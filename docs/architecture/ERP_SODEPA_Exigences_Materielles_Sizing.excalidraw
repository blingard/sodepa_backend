      "text": "EXIGENCE 1 : STOCKAGE SSD NVMe & DÉBIT I/O",
      "fontSize": 10.5,
      "baseFontSize": null,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "EXIGENCE 1 : STOCKAGE SSD NVMe & DÉBIT I/O",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "rYm93MqOOdezWSo1-lL2b",
      "type": "text",
      "x": 52,
      "y": 852,
      "width": 403.5872000000001,
      "height": 39.375,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ao",
      "roundness": null,
      "seed": 963679,
      "version": 3,
      "versionNonce": 156444478,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793033126256,
      "created": 1793033126256,
      "link": null,
      "locked": false,
      "text": "ClickHouse et PostgreSQL nécessitent un débit I/O élevé (minimum 5 000 IOPS).\nUn stockage NVMe monté en RAID 10 évite tout goulot d'étranglement lors des\nclôtures comptables périodiques et de l'ingestion asynchrone des écritures.",
      "fontSize": 10.5,
      "baseFontSize": null,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ClickHouse et PostgreSQL nécessitent un débit I/O élevé (minimum 5 000 IOPS).\nUn stockage NVMe monté en RAID 10 évite tout goulot d'étranglement lors des\nclôtures comptables périodiques et de l'ingestion asynchrone des écritures.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
