    {
      "id": "VeXjEN4rJ2GJU9QsX0eww",
      "type": "text",
      "x": 70,
      "y": 153,
      "width": 596.0143999999995,
      "height": 90,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a5",
      "roundness": null,
      "seed": 807146,
      "version": 3,
      "versionNonce": 724743522,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793033126256,
      "created": 1793033126254,
      "link": null,
      "locked": false,
      "text": "• Processeur (CPU) : 4 vCPU (2.4 GHz minimum, architecture x86_64)\n• Mémoire Vive (RAM) : 16 Go RAM (allocation conteneurs Docker & JVM)\n• Stockage Système & Données : 300 Go SSD SATA ou NVMe (IOPS modérés)\n• Bande Passante Réseau : 100 Mbps symétrique\n• Type d'Infrastructure : VM virtualisée unique (VMware / Proxmox / Cloud) avec Docker Compose\n• Objectif : Validation des sprints (S1–S16), tests d'intégration, recette VABF et formations utilisateurs",
      "fontSize": 12,
      "baseFontSize": null,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Processeur (CPU) : 4 vCPU (2.4 GHz minimum, architecture x86_64)\n• Mémoire Vive (RAM) : 16 Go RAM (allocation conteneurs Docker & JVM)\n• Stockage Système & Données : 300 Go SSD SATA ou NVMe (IOPS modérés)\n• Bande Passante Réseau : 100 Mbps symétrique\n• Type d'Infrastructure : VM virtualisée unique (VMware / Proxmox / Cloud) avec Docker Compose\n• Objectif : Validation des sprints (S1–S16), tests d'intégration, recette VABF et formations utilisateurs",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
