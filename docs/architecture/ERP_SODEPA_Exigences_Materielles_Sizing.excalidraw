      "seed": 773477,
      "version": 3,
      "versionNonce": 858462242,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793033126256,
      "created": 1793033126255,
      "link": null,
      "locked": false,
      "text": "• Rôle : Distribution assets SPA, TLS 1.3, CSP\n• CPU Staging / Prod : 0.5 vCPU → 1 à 2 vCPU\n• RAM Staging / Prod : 256 Mo → 512 Mo à 1 Go\n• Stockage disque : 15 Go SSD (bundles & logs)\n• Ports : 8080 (Docker) / 443 HTTPS (Public)\n• Scalabilité : Stateless, montée en charge aisée",
      "fontSize": 10.5,
      "baseFontSize": null,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Rôle : Distribution assets SPA, TLS 1.3, CSP\n• CPU Staging / Prod : 0.5 vCPU → 1 à 2 vCPU\n• RAM Staging / Prod : 256 Mo → 512 Mo à 1 Go\n• Stockage disque : 15 Go SSD (bundles & logs)\n• Ports : 8080 (Docker) / 443 HTTPS (Public)\n• Scalabilité : Stateless, montée en charge aisée",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
