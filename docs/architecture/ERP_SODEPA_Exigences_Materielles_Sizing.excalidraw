    {
      "id": "21R6vgCm9L53EE1Gzp7fu",
      "type": "text",
      "x": 1118,
      "y": 852,
      "width": 423.4574000000005,
      "height": 39.375,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aw",
      "roundness": null,
      "seed": 126673,
      "version": 3,
      "versionNonce": 1740544062,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793033126256,
      "created": 1793033126256,
      "link": null,
      "locked": false,
      "text": "DuckDB utilisant un fichier in-process (sodepa_audit.db), le backend doit rester\nen instance unique tant que l'idempotence n'est pas portée sur Redis.\nSauvegardes obligatoires : pg_dump quotidien + snapshots Vault + backup ClickHouse.",
      "fontSize": 10.5,
      "baseFontSize": null,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DuckDB utilisant un fichier in-process (sodepa_audit.db), le backend doit rester\nen instance unique tant que l'idempotence n'est pas portée sur Redis.\nSauvegardes obligatoires : pg_dump quotidien + snapshots Vault + backup ClickHouse.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    }
