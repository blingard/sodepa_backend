    {
      "id": "Vcum8Doo0iOOHnksmSg3s",
      "type": "text",
      "x": 585,
      "y": 852,
      "width": 423.2831000000005,
      "height": 39.375,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "as",
      "roundness": null,
      "seed": 409939,
      "version": 3,
      "versionNonce": 314896318,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793033126256,
      "created": 1793033126256,
      "link": null,
      "locked": false,
      "text": "Les ranches (Dumbo, Faro, Jakiri) et abattoirs doivent disposer d'un lien WAN/4G\nstable avec débit minimum de 2 Mbps par site et latence < 120ms via VPN IPsec.\nLa SPA Angular optimise la bande passante en ne transférant que des payloads JSON.",
      "fontSize": 10.5,
      "baseFontSize": null,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Les ranches (Dumbo, Faro, Jakiri) et abattoirs doivent disposer d'un lien WAN/4G\nstable avec débit minimum de 2 Mbps par site et latence < 120ms via VPN IPsec.\nLa SPA Angular optimise la bande passante en ne transférant que des payloads JSON.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
