    {
      "id": "83n6sEG9QttNFpPrJPqgA",
      "type": "text",
      "x": 1118,
      "y": 630,
      "width": 427.98920000000044,
      "height": 78.75,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aj",
      "roundness": null,
      "seed": 839325,
      "version": 3,
      "versionNonce": 830337122,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793033126256,
      "created": 1793033126255,
      "link": null,
      "locked": false,
      "text": "• Rôle : Stockage S3 pièces jointes, avatars, logos bancaires & édition GED in-app\n• CPU Staging / Prod : 1 vCPU → 2 vCPU\n• RAM Staging / Prod : 1.5 Go → 3 Go RAM\n• Stockage disque : 50 Go → 200 Go SSD (croissance selon volume documentaire GED)\n• Bucket initial : avatars et pièces comptables numérisées\n• Protocoles : S3 API (Port 9000) et WOPI / HTTP pour Collabora CODE (Port 9980)",
      "fontSize": 10.5,
      "baseFontSize": null,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Rôle : Stockage S3 pièces jointes, avatars, logos bancaires & édition GED in-app\n• CPU Staging / Prod : 1 vCPU → 2 vCPU\n• RAM Staging / Prod : 1.5 Go → 3 Go RAM\n• Stockage disque : 50 Go → 200 Go SSD (croissance selon volume documentaire GED)\n• Bucket initial : avatars et pièces comptables numérisées\n• Protocoles : S3 API (Port 9000) et WOPI / HTTP pour Collabora CODE (Port 9980)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
