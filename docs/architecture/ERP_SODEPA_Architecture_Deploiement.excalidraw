   "link": null,
   "locked": false,
   "text": "IMAGE DOCKER (sodepa-frontend)\n• Étape 1 Build : node:22-alpine (npm run build)\n• Étape 2 Runtime : nginx:1.27-alpine\n• Taille minimale sans outils de build\n• Package apk gettext pour envsubst au démarrage\n• Port d'écoute : 8080 (serveur HTTP)",
   "originalText": "IMAGE DOCKER (sodepa-frontend)\n• Étape 1 Build : node:22-alpine (npm run build)\n• Étape 2 Runtime : nginx:1.27-alpine\n• Taille minimale sans outils de build\n• Package apk gettext pour envsubst au démarrage\n• Port d'écoute : 8080 (serveur HTTP)",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "df_img",
   "autoResize": true,
   "lineHeight": 1.25
