    {
      "id": "YLqEEYcnICV2l-MJB1kGl",
      "type": "text",
      "x": 125,
      "y": 635,
      "width": 510.95599999999973,
      "height": 93.60000000000001,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6F",
