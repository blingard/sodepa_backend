      "seed": 125027,
      "version": 3,
      "versionNonce": 526278526,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792933826315,
      "created": 1792933826313,
      "link": null,
      "locked": false,
      "text": "• Framework Web moderne : Angular 21 Standalone & Zoneless Change Detection\n• Design System : Tailwind CSS 4 & Angular Material 21 (Thème institutionnel)\n• Intercepteurs HTTP : Injection automatique Auth (Bearer JWT) et Traçabilité\n• Traçabilité stricte : En-tête X-Correlation-Id (UUID v4) sur chaque requête\n• Sécurité & Sessions : Capture 401 silencieuse (/api/auth/refresh) & Gardes de routes\n• Modules mockés in-memory (useInMemoryApi) : RH (Personnel) & GED",
      "fontSize": 12,
      "baseFontSize": null,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Framework Web moderne : Angular 21 Standalone & Zoneless Change Detection\n• Design System : Tailwind CSS 4 & Angular Material 21 (Thème institutionnel)\n• Intercepteurs HTTP : Injection automatique Auth (Bearer JWT) et Traçabilité\n• Traçabilité stricte : En-tête X-Correlation-Id (UUID v4) sur chaque requête\n• Sécurité & Sessions : Capture 401 silencieuse (/api/auth/refresh) & Gardes de routes\n• Modules mockés in-memory (useInMemoryApi) : RH (Personnel) & GED",
      "autoResize": true,
      "lineHeight": 1.3,
      "labelPosition": null
    },
